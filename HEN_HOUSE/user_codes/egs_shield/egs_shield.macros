/*
   Redirect the $SELECT-PHOTON-MFP macro to the C++ implementation.
   This fires at the start of every photon free path and is where FD
   scoring happens in EGS_ShieldApplication::selectPhotonMFP().
   Without this override the Mortran default MFP sampling runs instead
   and the C++ selectPhotonMFP is never called.
*/
REPLACE {$SELECT-PHOTON-MFP;} WITH {;
    call select_photon_mfp(dpmfp);
    IF( dpmfp < 0 ) return;
};
