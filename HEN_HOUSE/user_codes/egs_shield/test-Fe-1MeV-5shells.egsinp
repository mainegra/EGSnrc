##############################################################################
#
# egs_shield smoke test: 1 MeV photons in iron sphere, 5 scoring shells
# (0.5, 1.0, 1.5, 2.0, 2.5 mfp), 1 combing shell at ~3 mfp.
#
# The combing shell is a thin iron region BETWEEN scoring positions — it must
# NOT coincide with a scoring shell and must have an iron buffer between it
# and the last scoring shell so that replayed virtual photons start in iron
# and scoreFD_all can correctly trace inward to score the 2.5 mfp shell.
#
# Region layout (0-based C++ indices):
#   Region 0:  iron (0 to 1.059985 cm)
#   Region 1:  air shell 0.5 mfp   [scoring]
#   Region 2:  iron
#   Region 3:  air shell 1.0 mfp   [scoring]
#   Region 4:  iron
#   Region 5:  air shell 1.5 mfp   [scoring]
#   Region 6:  iron
#   Region 7:  air shell 2.0 mfp   [scoring]
#   Region 8:  iron
#   Region 9:  air shell 2.5 mfp   [scoring, NOT combing]
#   Region 10: iron buffer (5.300225 to 6.360160 cm)
#   Region 11: thin iron combing shell (~3 mfp, 0.001 cm thick) [combing]
#   Region 12: outer iron absorber
#
# Shell volumes V = 4*pi*r_inner^2 * 0.0001 cm (100 um thick shells).
# Computed from masses in BUF input (m / rho_air, rho_air = 1.20479e-3 g/cm3):
#   k=0 (0.5 mfp): m=1.7012E-06 g => V=1.412E-03 cm3
#   k=1 (1.0 mfp): m=6.8049E-06 g => V=5.648E-03 cm3
#   k=2 (1.5 mfp): m=1.5311E-05 g => V=1.271E-02 cm3
#   k=3 (2.0 mfp): m=2.7220E-05 g => V=2.260E-02 cm3
#   k=4 (2.5 mfp): m=4.2531E-05 g => V=3.530E-02 cm3
#
##############################################################################

##############################################################################
### Run control — 10M photons (quick smoke test, ~1 min)
##############################################################################
:start run control:
    ncase = 1e7
    nbatch = 1
:stop run control:

##############################################################################
### Geometry — 5 scoring shells (10 iron+air pairs + outermost iron)
##############################################################################
:start geometry definition:

    :start geometry:
        name    = iron_sphere
        library = egs_spheres
        radii   = 1.059985 1.060085 \
                  2.120020 2.120120 \
                  3.180055 3.180155 \
                  4.240090 4.240190 \
                  5.300125 5.300225 \
                  6.360160 6.361160 \
                  53.001700

        :start media input:
            media   = iron air
            set medium = 1  1
            set medium = 3  1
            set medium = 5  1
            set medium = 7  1
            set medium = 9  1
        :stop media input:
    :stop geometry:

    simulation geometry = iron_sphere

:stop geometry definition:

##############################################################################
### Media
##############################################################################
:start media definition:

    ae = 0.521
    ue = 2.511
    ap = 0.010
    up = 2.0

    :start iron:
        density correction file = iron
    :stop iron:

    :start air:
        density correction file = air_dry_nearsealevel
    :stop air:

:stop media definition:

##############################################################################
### Source — isotropic point source at origin
##############################################################################
:start source definition:

    :start source:
        name      = point_source
        library   = egs_isotropic_source
        charge    = 0
        :start spectrum:
            type   = monoenergetic
            energy = 1
        :stop spectrum:
        :start shape:
            type     = point
            position = 0 0 0
        :stop shape:
    :stop source:

    simulation source = point_source

:stop source definition:

:start rng definition:
    type = xoshiro256++
    initial seeds = 12345 67890
:stop rng definition:

##############################################################################
### Scoring options (egs_shield format)
##############################################################################
:start scoring options:

    geometry name     = iron_sphere

    # 0-based C++ region indices of the thin air scoring shells
    scoring regions   = 1 3 5 7 9

    # Shell volumes [cm^3], one per scoring shell
    scoring volumes   = 1.412E-03 5.648E-03 1.271E-02 2.260E-02 3.530E-02

    # Combing shell — thin iron region at ~3 mfp (region 11), NOT a scoring shell
    combing regions   = 11

    emuen file        = $EGS_HOME/egs_kerma/emuen_rho_air_1keV-20MeV.data

    n bunches         = 10
    photons per bunch = 1000000

:stop scoring options:

:start variance reduction:
:stop variance reduction:

:start MC transport parameter:
    Global ECUT                  = 0.521
    Global PCUT                  = 0.010
    Rayleigh scattering          = On
    Photoelectron angular sampling = Off
    Brems angular sampling       = Simple
    Bound Compton scattering     = norej
    Pair angular sampling        = Off
    ESTEPE                       = 0.25
    XIMAX                        = 0.5
    Skin depth for BCA           = 3
    Boundary crossing algorithm  = EXACT
    Electron-step algorithm      = PRESTA-II
:stop MC transport parameter:
